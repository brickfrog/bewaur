# Maintainer: brickfrog
pkgname=bewaur
pkgver=0.4.1
pkgrel=2
pkgdesc='Trust scoring for AUR packages'
arch=('x86_64')
url='https://github.com/brickfrog/bewaur'
license=('MIT')
depends=('git' 'pacman' 'gcc-libs' 'glibc' 'openssl' 'xz' 'zstd')
makedepends=('cargo' 'pkgconf')
conflicts=('traur' 'traur-bin')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm0755 target/release/bewaur "$pkgdir/usr/bin/bewaur"
    install -Dm0755 target/release/bewaur-hook "$pkgdir/usr/bin/bewaur-hook"
    # CachyOS pacman isolates hooks; stock pacman rejects its NetworkAccess key.
    local hook_file=hook/bewaur.hook
    if pacman --disable-sandbox-network --version >/dev/null 2>&1; then
        hook_file=hook/bewaur-network.hook
    fi
    install -Dm0644 "$hook_file" "$pkgdir/usr/share/libalpm/hooks/bewaur.hook"
    install -Dm0644 data/patterns.toml "$pkgdir/usr/share/bewaur/patterns.toml"
    # Opt-in unattended scan: systemctl --user enable --now bewaur-scan.timer
    install -Dm0644 hook/bewaur-scan.service "$pkgdir/usr/lib/systemd/user/bewaur-scan.service"
    install -Dm0644 hook/bewaur-scan.timer "$pkgdir/usr/lib/systemd/user/bewaur-scan.timer"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
